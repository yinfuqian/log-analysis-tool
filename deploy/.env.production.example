# 生产环境配置示例。复制为 .env.production 后填写真实值，禁止把真实密码和令牌提交到 Git。

# 每次发布使用不可变版本号，不建议生产环境使用 latest。
BACKEND_IMAGE=your-registry/log-analyzer-backend:latest
FRONTEND_IMAGE=your-registry/log-analyzer-frontend:latest

API_PORT=5000
FRONTEND_PORT=8080
WEB_CONCURRENCY=4
WEB_THREADS=8
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT=300
CELERY_WORKER_CONCURRENCY=4

# 生产 Compose 不会启动 MySQL 和 Redis，必须填写服务器可访问的外部地址。
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_DATABASE=log_analyzer
MYSQL_USERNAME=your-mysql-user
MYSQL_PASSWORD=change-me
SQLALCHEMY_POOL_RECYCLE=1800

REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=change-me
REDIS_SOCKET_CONNECT_TIMEOUT=10
REDIS_SOCKET_TIMEOUT=60
REDIS_HEALTH_CHECK_INTERVAL=30
CELERY_BROKER_SOCKET_TIMEOUT=360
CELERY_BROKER_POOL_LIMIT=10
CELERY_VISIBILITY_TIMEOUT=7200

STORAGE_TYPE=local
LOGGING_LEVEL=INFO

# users.csv 由生产服务器管理员维护并热加载，状态：1=启用、0=禁用、2=立即下线。
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=300

# 账号申请邮件接口；暂时不用真实接口时可改为 mock 并清空地址。
ACCOUNT_REQUEST_PROVIDER=http
ACCOUNT_REQUEST_API_URL=https://example.com/prod-api/open/api/sendEmail
ACCOUNT_REQUEST_API_TOKEN=
ACCOUNT_REQUEST_API_TIMEOUT=10

# Git 配置只从此生产环境文件注入。
GIT_BASE_URL=https://git.example.com/
GIT_USER=your-git-username
GIT_PASSWORD=change-me
GITLAB_PRIVATE_TOKEN=change-me
GITLAB_PROJECT_MEMBERSHIP_ONLY=false
GITLAB_API_TIMEOUT=30
GITLAB_API_MAX_RETRIES=3
GITLAB_API_RETRY_DELAY=1
GITLAB_DB_MAX_RETRIES=2
GITLAB_SYNC_SKIP_EXISTING_REPOS=true

# 故障分析模型和深度思考配置。
OPENAI_KEY=sk-your-api-key
OPENAI_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol
OPENAI_API_STYLE=chat
OPENAI_REASONING_EFFORT=high
LOG_ERROR_CONTEXT_LINES=10
LOG_CONTEXT_MAX_CHARS=30000

# OCR 已在后端发布镜像内安装并完成构建自检。
LOCAL_OCR_ENABLED=true
OCR_MIN_CONFIDENCE=0.45
