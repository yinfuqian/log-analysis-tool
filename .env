# Docker runtime configuration for log-analyzer.
# Keep this file local. It may contain credentials.
API_PORT=5000
WEB_CONCURRENCY=4
CELERY_WORKER_CONCURRENCY=4
WEB_THREADS=8
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT=300
PYTHON_BASE_IMAGE=registry.cn-hangzhou.aliyuncs.com/k8s-docker-image-yfq/python:3.10-slim
APT_MIRROR=https://mirrors.aliyun.com/debian
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=/data/upload
LOG_DIR=/app/app/logs
LOGGING_LEVEL=DEBUG
MYSQL_HOST=172.16.55.50
MYSQL_PORT=3306
# Docker Compose 容器使用下面的 COMPOSE_ 配置连接外部 MySQL。
# 外部依赖模式保持 COMPOSE_PROFILES 为空，不会创建本地 MySQL/Redis 容器。
COMPOSE_MYSQL_HOST=172.16.55.50
COMPOSE_MYSQL_PORT=3306
MYSQL_DATABASE=log_analyzer
MYSQL_USERNAME=root
MYSQL_PASSWORD=uWXf87plmQGz8zMM
SQLALCHEMY_POOL_RECYCLE=1800
REDIS_HOST=172.16.55.50
REDIS_PORT=6379
# Docker Compose 容器使用下面的 COMPOSE_ 配置连接外部 Redis。
COMPOSE_REDIS_HOST=172.16.55.50
COMPOSE_REDIS_PORT=6379
REDIS_DATABASE=0




# Authentication and account requests
AUTH_USERS_FILE=../users.csv
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=300
# 账号申请通过 HTTP 邮件接口发送，不在本地保存申请记录。
# 字段映射：用户名->register_account，申请人姓名->register_user，密码->register_pwd。
ACCOUNT_REQUEST_PROVIDER=http
ACCOUNT_REQUEST_API_URL=http://qwbot30.wezhuiyi.com:9595/prod-api/open/api/sendEmail
# 当前接口未要求 Bearer Token，保持为空；后续需要鉴权时再填写。
ACCOUNT_REQUEST_API_TOKEN=
# HTTP 超时时间（秒）；HTTP 或业务 code 非 200 时统一提示联系管理员。
ACCOUNT_REQUEST_API_TIMEOUT=10
LOCAL_OCR_ENABLED=true
OCR_MIN_CONFIDENCE=0.45
WINDOWS_CLIENT_BACKEND_URL=http://qwbot30.wezhuiyi.com:9595/zhuiyi/logapi

REDIS_USERNAME=default
REDIS_PASSWORD=admin1234
GIT_BASE_URL=https://code.in.wezhuiyi.com/
GIT_USER=yinfuqian1193
GIT_PASSWORD=yfq1193
GITLAB_PRIVATE_TOKEN=b9JjvYBxJSiewgy-zD6A
GITLAB_PROJECT_MEMBERSHIP_ONLY=false
GITLAB_API_TIMEOUT=30
GITLAB_API_MAX_RETRIES=3
GITLAB_API_RETRY_DELAY=1
GITLAB_DB_MAX_RETRIES=2
GITLAB_SYNC_SKIP_EXISTING_REPOS=true
# 本地构建产物名称；api、worker、migrate 共用同一个后端镜像。
BACKEND_IMAGE=registry.cn-hangzhou.aliyuncs.com/k8s-docker-image-yfq/tools:backend-2026-09-18
# Web 前端生产镜像，由 docker compose up --build 自动构建。
FRONTEND_IMAGE=registry.cn-hangzhou.aliyuncs.com/k8s-docker-image-yfq/tools:frontend-2026-07-18-2
# 留空表示使用上面的外部 MySQL/Redis；本地依赖模式可改为 local-deps。
COMPOSE_PROFILES=
OPENAI_URL=https://newapi.in.wezhuiyi.com/v1
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=high

OPENAI_API_STYLE=responses
LOG_ERROR_CONTEXT_LINES=10
LOG_CONTEXT_MAX_CHARS=30000
#OPENAI_URL=https://yinfuqian1193.in.wezhuiyi.com/v1


# ===== 技能执行（Codex Agent）=====
# 以下为已验证可用的默认值，除标注「必填」的两项外均可直接沿用。
# 外部系统调用 /skill 接口时使用独立令牌；默认值仅用于本地验证，生产环境必须替换为随机强令牌。
SKILL_API_TOKEN=local-dev-token
# jira_url 允许的主机白名单，逗号分隔；留空表示不限制。
SKILL_URL_ALLOWED_HOSTS=jira-test.in.wezhuiyi.com
# 【必填】技能自带的 Jira 个人访问令牌，注入给技能脚本（jira-cli.mjs 读取 JIRA_TOKEN）。
JIRA_TOKEN=
JIRA_BASE_URL=https://jira-test.in.wezhuiyi.com
# 流水线 MCP：jira-code 的热更新阶段通过 pipeline-integration-mcp 把改动热更新到方案指定环境。
# 令牌在流水线平台个人中心签发，属于敏感信息，不写默认值；留空时后端不注册 MCP，热更新按跳过处理。
DEVOPS_MCP_URL=https://devops.ks1.wezhuiyi.com/mcp
DEVOPS_MCP_TOKEN=
# 构建后端镜像时使用的 Codex CLI 版本与 npm 源。
CODEX_CLI_VERSION=0.142.5
NPM_REGISTRY=https://registry.npmmirror.com
# 留给技能执行的 Codex 模型参数；CODEX_API_KEY 为空时回退到 OPENAI_KEY。
CODEX_MODEL=codex/deepseek-flash
CODEX_MODEL_PROVIDER=skillrun
CODEX_BASE_URL=https://newapi.in.wezhuiyi.com/v1
# 【必填】Codex 使用的模型中转令牌。
CODEX_API_KEY=
CODEX_API_KEY_ENV=CODEX_SKILL_API_KEY
CODEX_WIRE_API=responses
CODEX_REASONING_EFFORT=high
CODEX_SANDBOX=danger-full-access
CODEX_EPHEMERAL=true
CODEX_SKILL_TIMEOUT=1800
# 连续多少次网络错误后判定模型/Jira 不可达并提前终止（默认 3）。
CODEX_NETWORK_RETRY_LIMIT=10
# worker 启动时把上一次遗留的“执行中”任务标记为失败（默认 true）。
SKILL_RECOVER_ORPHANS=true
