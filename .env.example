# Copy this file to .env and fill in real values before running Docker.
# Do not put production secrets in this committed example file.

API_PORT=5000
FRONTEND_PORT=8080
MYSQL_EXPOSE_PORT=3306
REDIS_EXPOSE_PORT=6379

# 可替换为企业内部镜像仓库。默认使用国内可访问的镜像代理。
PYTHON_BASE_IMAGE=docker.m.daocloud.io/library/python:3.10-slim-bookworm
NODE_BASE_IMAGE=docker.m.daocloud.io/library/node:20-bookworm-slim
NGINX_BASE_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.4
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7.4-alpine
WEB_CONCURRENCY=4
WEB_THREADS=8
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT=300
CELERY_WORKER_CONCURRENCY=4
BACKEND_IMAGE=fault-analysis-backend:latest
FRONTEND_IMAGE=fault-analysis-frontend:latest
APT_MIRROR=https://mirrors.aliyun.com/debian
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

STORAGE_TYPE=local
LOCAL_STORAGE_DIR=/data/upload
LOG_DIR=/app/app/logs
LOGGING_LEVEL=INFO

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=log_analyzer
MYSQL_USERNAME=log_analyzer
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=root-change-me
SQLALCHEMY_POOL_RECYCLE=1800

# Docker Compose 默认使用外部依赖；填写外部地址后直接执行 docker compose up。
# 需要 Compose 启动本地 MySQL/Redis 时使用 --profile local-deps。
COMPOSE_MYSQL_HOST=
COMPOSE_MYSQL_PORT=3306

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SOCKET_CONNECT_TIMEOUT=10
REDIS_SOCKET_TIMEOUT=60
REDIS_HEALTH_CHECK_INTERVAL=30
COMPOSE_REDIS_HOST=
COMPOSE_REDIS_PORT=6379
CELERY_BROKER_SOCKET_TIMEOUT=360
CELERY_BROKER_POOL_LIMIT=10
CELERY_VISIBILITY_TIMEOUT=7200

# Hot-reloaded CSV columns: username,password,status (1=enabled, 0=disabled, 2=forced offline).
# Relative paths are resolved from backend/. Docker Compose overrides this with /data/users.csv.
AUTH_USERS_FILE=../users.csv
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=300
ACCOUNT_REQUEST_PROVIDER=mock
ACCOUNT_REQUEST_API_URL=
ACCOUNT_REQUEST_API_TOKEN=
ACCOUNT_REQUEST_API_TIMEOUT=10
# HTTP 提供方字段映射：username -> register_account，applicant_name -> register_user，password -> register_pwd。
# 接口响应 JSON 的 code 必须为 200，否则客户端提示账号申请失败并联系管理员。

# Optional: embedded into the Windows client by windows-client/build-exe.bat.
# When omitted, the packaged client defaults to http://127.0.0.1:5000.
# WINDOWS_CLIENT_BACKEND_URL=https://example.com/logapi

GIT_BASE_URL=https://gitlab.example.com/
GIT_USER=
GIT_PASSWORD=
GITLAB_PRIVATE_TOKEN=
GITLAB_PROJECT_MEMBERSHIP_ONLY=false
GITLAB_API_TIMEOUT=30
GITLAB_API_MAX_RETRIES=3
GITLAB_API_RETRY_DELAY=1
GITLAB_DB_MAX_RETRIES=2
GITLAB_SYNC_SKIP_EXISTING_REPOS=true

OPENAI_KEY=
OPENAI_URL=https://api.deepseek.com
OPENAI_MODEL=gpt-5.6-sol
# chat: /v1/chat/completions; responses: /v1/responses
OPENAI_API_STYLE=chat
OPENAI_REASONING_EFFORT=high
LOG_ERROR_CONTEXT_LINES=10
LOG_CONTEXT_MAX_CHARS=30000
# Local image OCR. Models are cached in PADDLE_PDX_CACHE_HOME and OCR does not call OpenAI.
LOCAL_OCR_ENABLED=true
OCR_MIN_CONFIDENCE=0.45
PADDLE_PDX_CACHE_HOME=/data/paddle-cache
