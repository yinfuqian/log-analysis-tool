# Copy this file to .env and fill in real values before running Docker.
# Do not put production secrets in this committed example file.

API_PORT=5000
WEB_CONCURRENCY=4
WEB_THREADS=8
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT=300
CELERY_WORKER_CONCURRENCY=4
BACKEND_IMAGE=registry.cn-hangzhou.aliyuncs.com/k8s-docker-image-yfq/tools:logtoolsv1

PYTHON_BASE_IMAGE=registry.cn-hangzhou.aliyuncs.com/k8s-docker-image-yfq/python:3.10-slim
APT_MIRROR=https://mirrors.aliyun.com/debian
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

STORAGE_TYPE=local
LOCAL_STORAGE_DIR=/data/upload
LOG_DIR=/app/app/logs
LOGGING_LEVEL=INFO

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=log_analyzer
MYSQL_USERNAME=log_analyzer
MYSQL_PASSWORD=change-me
SQLALCHEMY_POOL_RECYCLE=1800

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SOCKET_CONNECT_TIMEOUT=10
REDIS_SOCKET_TIMEOUT=60
REDIS_HEALTH_CHECK_INTERVAL=30
CELERY_BROKER_SOCKET_TIMEOUT=360
CELERY_BROKER_POOL_LIMIT=10
CELERY_VISIBILITY_TIMEOUT=7200

# Authentication users are managed in this JSON file. Store password hashes only.
AUTH_USERS_FILE=/data/users.json
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=300

GIT_BASE_URL=https://gitlab.example.com/
GIT_USER=
GIT_PASSWORD=
GITLAB_PRIVATE_TOKEN=
GITLAB_PROJECT_MEMBERSHIP_ONLY=false
GITLAB_API_TIMEOUT=30
GITLAB_API_MAX_RETRIES=3
GITLAB_API_RETRY_DELAY=1
GITLAB_DB_MAX_RETRIES=2
GITLAB_SYNC_SKIP_EXISTING_REPOS=true

OPENAI_KEY=
OPENAI_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
# chat: /v1/chat/completions; responses: /v1/responses
OPENAI_API_STYLE=chat
LOG_ERROR_CONTEXT_LINES=10
LOG_CONTEXT_MAX_CHARS=30000
BACKEND_IMAGE=registry.cn-hangzhou.aliyuncs.com/k8s-docker-image-yfq/tools:logtoolsv1
